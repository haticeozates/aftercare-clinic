APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key
SUPABASE_PROJECT_REF=local-aftercare
PRODUCTION_SUPABASE_PROJECT_REF=replace-with-production-ref-when-approved
AUDIT_LOG_PEPPER=replace-with-local-random-value
RATE_LIMIT_PEPPER=replace-with-local-random-value
RATE_LIMIT_CLEANUP_SECRET=replace-with-local-cleanup-secret

# Optional canonical origin for public metadata and sitemap. Use the final HTTPS origin.
# AFTERCARE_PUBLIC_SITE_URL=https://aftercare.example

# Local verification only. supabase:write-env fills these from the local stack.
# TEST_DATABASE_URL=
# SUPABASE_DB_URL=
# PHOTO_CLEANUP_SECRET=

# Optional local-only demo switches. Hosted portfolio values remain false.
# PHASE11_DEMO_ENABLED=false
# PHASE12_PUBLIC_DEMO_ENABLED=false
# PHASE13_MAIL_ENABLED=false
